{
  "mcpServers": {
    "scout-portfolio": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "scout-portfolio-manager"
      ],
      "env": {
        "ZERION_API_KEY": "${ZERION_API_KEY:-}",
        "ZERION_WALLET_ADDRESS": "${ZERION_WALLET_ADDRESS:-}"
      }
    }
  }
}
